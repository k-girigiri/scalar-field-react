{
  "name": "scalar-field-react",
  "version": "0.1.0",
  "description": "Render 2D scalar fields from scattered data points to an HTML canvas with Gaussian interpolation, polygon masking, and color maps — a small, typed React library.",
  "type": "module",
  "license": "MIT",
  "author": "k-girigiri",
  "keywords": [
    "react",
    "canvas",
    "scalar-field",
    "interpolation",
    "gaussian",
    "heatmap",
    "colormap",
    "jet",
    "visualization",
    "typescript"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k-girigiri/scalar-field-react.git"
  },
  "homepage": "https://github.com/k-girigiri/scalar-field-react#readme",
  "bugs": {
    "url": "https://github.com/k-girigiri/scalar-field-react/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:tarball": "node scripts/tarball-integration.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^2.1.4",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.0",
    "vitest": "^2.1.4"
  }
}
